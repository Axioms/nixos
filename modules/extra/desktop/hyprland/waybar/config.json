{
  "layer": "top",
  "position": "top",
  "margin": "5 0",
  "modules-left": [
    "group/left-hidden-top",
    "group/left"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/right-left",
    "group/right",
    "group/right-hidden-top"
  ],
  "group/left": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/window"
    ]
  },
  "group/left-hidden": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/arrow-right",
      "network#info",
      "temperature",
      "cpu",
      "load",
      "memory",
      "memory#swap",
      "disk"
    ]
  },
  "group/left-hidden-top": {
    "orientation": "horizontal",
    "modules": [
      "power-profiles-daemon",
      "group/left-hidden"
    ]
  },
  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "idle_inhibitor",
      "custom/email",
      "pulseaudio#input",
      "group/group-volume",
      "group/group-backlight",
      "network",
      "battery"
    ]
  },
  "group/right-left": {
    "orientation": "horizontal",
    "modules": [
      "tray"
    ]
  },
  "group/right-hidden": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
      "click-to-reveal": true
    },
    "modules": [
      "custom/arrow-left",
      "custom/arrow-right",
      "network#info",
      "temperature",
      "cpu",
      "load",
      "memory",
      "memory#swap",
      "disk"
    ]
  },
  "group/right-hidden-top": {
    "orientation": "horizontal",
    "modules": [
      "group/right-hidden",
      "custom/ctlcenter"
    ]
  },
  "mango/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰮯",
      "default": "",
      "empty": ""
    },
    "num-tags": 5,
    "on-click": "activate",
    "overview-label": ""
  },
  "niri/workspaces": {
    "format": "{icon}",
    "cursor": true,
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down",
    "hide-empty": true,
    "format-icons": {
      "active": "󰮯",
      "default": "",
      "empty": ""
    }
  },
  "cpu": {
    "interval": 30,
    "format": " {usage}%",
    "cursor": true,
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "tray": {
    "icon-size": 13,
    "spacing": 12,
    "cursor": true
  },
  "load": {
    "interval": 30,
    "format": " {load1}%",
    "cursor": true
  },
  "memory": {
    "interval": 10,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
    "memory#swap": {
      "interval": 6,
      "format": "󰾵 {swapUsed}/{swapTotal}GiB"
    },
  "backlight": {
    "scroll-step": 2,
    "format": "{icon}",
    "tooltip-format": "{percent}%",
    "format-icons": [
      "󰃞",
      "󰃝",
      "󰃟",
      "󰃠"
    ]
  },
    "network#info": {
      "interval": 2,
      "format": "󱘖  Offline",
      "format-wifi": "{icon} {bandwidthDownBits}",
      "format-ethernet": "󰈀  󰇚 {bandwidthDownBits} 󰕒 {bandwidthUpBits}",
      "min-length": 11,
      "tooltip": "{}",
      "tooltip-format-wifi": "{ifname}\n{essid}\n{signalStrength}% \n{frequency} GHz\n󰇚 {bandwidthDownBits}\n󰕒 {bandwidthUpBits}",
      "tooltip-format-ethernet": "{ifname}\n󰇚 {bandwidthDownBits} \n󰕒 {bandwidthUpBits}",
      "on-click": "iwgtk& aplay ~/.config/sounds/interact.wav",
      "format-icons": ["󰤫", "󰤟", "󰤢", "󰤥", "󰤨"],
      "states": {
        "normal": 25
      }
    },
  "pulseaudio#output": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-source-muted": "{volume}",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        ""
      ]
    },
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click": "pwvucontrol & aplay ~/.config/sounds/interact.wav",
    "tooltip": true,
    "scroll-step": 5
  },
  "pulseaudio#input": {
    "format": "",
    "format-source": "{volume}",
    "format-source-muted": "{volume}",
    "on-scroll-up": "sh -c 'vol=$(pactl get-source-volume @DEFAULT_SOURCE@ | grep -oP \"\\d+(?=%)\" | head -1); if [ \"$vol\" -lt 100 ]; then pactl set-source-volume @DEFAULT_SOURCE@ +5%; fi'",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
    "max-volume": "100",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-click": "pwvucontrol & aplay ~/.config/sounds/interact.wav",
    "tooltip-format": "{format_source}%"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "cursor": true,
    "zero-on-mute": true,
    "unmute-on-volume-change": true,
    "on-click-right": "hyprctl eval \"hl.exec_cmd('pavucontrol -t 4')\""
  },
  "backlight/slider": {
    "min": 5,
    "max": 100,
    "cursor": true
  },
  "network": {
    "interval": 10,
    "format-disabled": "",
    "format-disconnected": "",
    "format-wifi": "",
    "format-ethernet": "",
    "tooltip-format": "{essid}\n\nFrequency: {frequency}GHz\nStrength: {signalStrength}%\n\n{bandwidthUpBytes}   {bandwidthDownBytes}"
  },
      "disk": {
      "interval": 10,
      "format": " {percentage_used}%",
      "tooltip": "{}",
      "tooltip-format": "Free {free}",
      "on-click": "qdirstat & aplay ~/.config/sounds/interact.wav",
      "states": {
        "warning": 85,
        "critical": 95
      }
    },
  "bluetooth": {
    "format": "{}",
    "format-on": "󰂰",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "{device_alias}",
    "format-connected-battery": "{device_alias}",
    "tooltip-format": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}   {device_battery_percentage}%",
    "on-click": "~/.local/bin/toggle_bluetooth &",
    "on-click-right": "hyprctl eval \"hl.exec_cmd('blueman-manager')\""
  },
  "battery": {
    "interval": 20,
    "full-at": 100,
    "tooltip": true,
    "format-full": "",
    "format": "{icon} {capacity}%",
    "format-time": "{H}:{M:02}",
    "format-charging": " {capacity}% ({time})",
    "format-charging-full": " {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂂",
      "󰁹"
    ],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "clock": {
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "format-alt": "  {:%H:%M:%S    %m/%d}",
    "interval": 1,
    "on-click-right": "",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#acb0d0'><b>{}</b></span>",
        "weeks": "<span color='#7aa2f7'><b>W{}</b></span>",
        "weekdays": "<span color='#e0af68'><b>{}</b></span>",
        "days": "<span color='#acb0d0'><b>{}</b></span>",
        "today": "<span color='#41a6b5'><b><u>{}</u></b></span>"
      }
    }
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "custom/ctlcenter": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/arrow-left": {
    "format": "",
    "tooltip": false,
    "cursor": true
  },
  "custom/arrow-right": {
    "format": "",
    "tooltip": false,
    "cursor": true
  },
  "group/group-volume": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": true,
      "reveal-delay": 450
    },
    "modules": [
      "pulseaudio#output",
      "pulseaudio/slider"
    ]
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 100,
    "tooltip": false,
    "icon": true,
    "icon-size": 18,
    "tooltip": true
  },
  "custom/email": {
    "format": "{}",
    "exec": "~/.share/thunderbird/email-widget.sh",
    "return-type": "json",
    "interval": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"email\")'"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰒲"
    }
  },
  "temperature": {
    "critical-threshold": 90,
    "interval": 4,
    "format": "{icon} {temperatureC}°",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": false
  },
  "group/group-backlight": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": true,
      "reveal-delay": 450
    },
    "modules": [
      "backlight",
      "backlight/slider"
    ]
  }
}